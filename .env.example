# Copy this to .env for local dev if you want (optional — the app works fine without it locally).
# On Netlify, set this under Site Configuration → Environment Variables.

# Any long random string — this is what signs your login cookies. Make one up, keep it secret.
JWT_SECRET=change-this-to-something-long-and-random

# NO database variables needed!
# This app uses Netlify Blobs for storage — it's built into Netlify and requires zero setup.
# Locally, data is stored in db.json automatically.
