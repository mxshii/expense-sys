# Copy this to .env for local dev.
# On Vercel, set these under Project Settings → Environment Variables.

# Get this from your Neon dashboard (neon.tech) → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Any long random string — this signs your login cookies. Keep it secret!
JWT_SECRET=change-this-to-something-long-and-random

# Optional: Set a topic name for mobile push alerts via ntfy.sh (leave empty for PC/Laptop-only)
NTFY_TOPIC=
