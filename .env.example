# Copy this to .env for local dev if you want (optional — the app works fine without it locally).
# On Netlify, set these under Site Configuration → Environment Variables.

# Any long random string — this is what signs your login cookies. Make one up, keep it secret.
JWT_SECRET=change-this-to-something-long-and-random

# Required for production (Upstash Redis).
# Copy these values from your Upstash Console (console.upstash.com) → your database → REST API.
# On Netlify, add them under Site Configuration → Environment Variables.
KV_REST_API_URL=
KV_REST_API_TOKEN=
